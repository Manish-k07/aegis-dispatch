# Local / Docker PostgreSQL
POSTGRES_DB=aegis_dispatch
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/aegis_dispatch
DB_USER=aegis
DB_PASSWORD=change-me

# Frontend origin allowed by the API. For Cloud Run same-origin deployment,
# set this to the Cloud Run HTTPS origin.
CORS_ORIGIN=http://localhost:5173

# Optional operational tuning
STALE_SECONDS=60
ETA_WEIGHT=0.30
CAPABILITY_WEIGHT=0.30
AVAILABILITY_WEIGHT=0.15
DISTANCE_WEIGHT=0.15
TRAFFIC_WEIGHT=0.10
