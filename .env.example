# ==============================================================================
# Aegis Dispatch CAD • Environment Configuration Template
# Copy to `.env` before starting production deployment: `cp .env.example .env`
# ==============================================================================

# Application Environment Profile (postgres | default | dev-seed)
SPRING_PROFILES_ACTIVE=postgres

# Server Ports
PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
VITE_ENABLE_DEMO_BUTTON=true

# Security & CORS Origins (Comma-separated list of permitted frontend origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost

# Initial Administrator Bootstrap Account (Created automatically on empty DB)
AEGIS_ADMIN_USERNAME=admin
AEGIS_ADMIN_PASSWORD=Admin@Aegis2026

# Routing & Navigation Engine
OSRM_BASE_URL=https://router.project-osrm.org

# PostgreSQL Database Configuration
POSTGRES_DB=aegis_dispatch
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace_with_strong_production_password_here
DB_URL=jdbc:postgresql://postgres:5432/aegis_dispatch
DB_USER=aegis
DB_PASSWORD=replace_with_strong_production_password_here

# CAD Dispatch Algorithm Tuning Weights (Must sum to 1.0)
ETA_WEIGHT=0.30
CAPABILITY_WEIGHT=0.30
AVAILABILITY_WEIGHT=0.15
DISTANCE_WEIGHT=0.15
TRAFFIC_WEIGHT=0.10

# Stale Telemetry Timeout in Seconds
STALE_SECONDS=60
